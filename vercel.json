{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "dest": "/api/index.ts"
    },
    {
      "src": "/uploads/(.*)",
      "methods": ["GET", "POST"],
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "methods": ["GET"],
      "dest": "/dist/index.html"
    }
  ]
}
