# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APP_URL: Optional client-side URL for the deployed backend API (defaults to APP_URL).
# Used when deploying frontend to Vercel so the frontend connects to the deployed backend.
VITE_APP_URL="https://ais-dev-pckpcvo3je4jpqrb53lcee-624129667025.asia-southeast1.run.app"

# JWT_SECRET: Secret key for signing and verifying authentication tokens. (Keep strictly server-side)
JWT_SECRET="your-jwt-secret-token"
